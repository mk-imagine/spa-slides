{
  "name": "spa-slides-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build -w @mk-imagine/spa-slides && npm run build -w git-workshop-deck",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test -w @mk-imagine/spa-slides",
    "lint": "npm run lint -w git-workshop-deck",
    "verify": "npm run verify -w git-workshop-deck"
  }
}
